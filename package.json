{
  "name": "agesture",
  "version": "0.0.1",
  "description": "A browser extension for mouse gestures",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "start": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write --formatter-enabled=true --assist-enabled=true --unsafe",
    "check": "biome check .",
    "test": "vitest run",
    "e2e": "wxt build && playwright test",
    "check_all": "npm run format && npm run check && npm run typecheck && npm run test && npm run e2e",
    "deploy_for_local": "npm run build && mkdir -p $AGESTURE_LOCAL && cp -rf ./.output/chrome-mv3/* $AGESTURE_LOCAL"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "lefthook": "^2.1.14",
    "tailwindcss": "^4.1.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "web-ext": "^10.7.0",
    "wxt": "0.21.4"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.5.0"
  }
}
